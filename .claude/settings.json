{
  "permissions": {
    "deny": [
      "Read(./private/**)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | grep '\\.py$' | xargs -r ruff format"
          }
        ]
      }
    ]
  }
}